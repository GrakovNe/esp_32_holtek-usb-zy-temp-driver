# The variable must come before HEX: with HEX first CMake reads into a
# variable named HEX and leaves ours empty without an error.
file(READ "${BIN}" hx HEX)
string(REGEX MATCHALL ".." bytes "${hx}")
list(LENGTH bytes n)
if(n EQUAL 0)
    message(FATAL_ERROR "bin2header: ${BIN} produced no bytes")
endif()
list(TRANSFORM bytes PREPEND "0x")
list(JOIN bytes "," body)
file(WRITE "${OUT}" "/* generated by bin2header.cmake - do not edit */\n"
     "static const unsigned char ${SYM}[] = {${body}};\n"
     "static const unsigned int ${SYM}_len = ${n};\n")
