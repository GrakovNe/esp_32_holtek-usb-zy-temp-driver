CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# No PSRAM: the firmware fits in internal RAM, so any ESP32-S3 module works.
CONFIG_SPIRAM=n

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_FREERTOS_HZ=1000

CONFIG_LWIP_NETIF_LOOPBACK=y

# With Wi-Fi active the default root-port reset is too fast for the sensor.
CONFIG_USB_HOST_RESET_RECOVERY_MS=300

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_WIFI_NVS_ENABLED=n

# For the "skip certificate verification" MQTT option.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

CONFIG_LWIP_MAX_SOCKETS=32

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
